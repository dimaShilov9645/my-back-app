generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  key
  topup
  subscription
  giftcard
}

enum OrderStatus {
  created
  paid
  delivering
  delivered
  payment_failed
  out_of_stock
  delivery_failed
  expired
}

enum PaymentStatus {
  paid
  failed
}

model Product {
  id          String       @id @default(uuid()) @db.Uuid
  sku         String       @unique
  name        String
  type        ProductType
  price       Int
  currency    String       @default("RUB") @db.VarChar(3)
  image       String?
  isActive    Boolean      @default(true)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  orders      Order[]
  productKeys ProductKey[]

  @@map("products")
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  idempotencyKey String       @unique @db.Uuid
  productId      String       @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  amount         Int
  currency       String       @db.VarChar(3)
  status         OrderStatus  @default(created)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  delivery       Delivery?
  reservation    Reservation?

  @@index([productId])
  @@index([status, createdAt])
  @@map("orders")
}

model ProductKey {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  productId   String       @db.Uuid
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  delivery    Delivery?
  reservation Reservation?

  @@index([productId])
  @@map("product_keys")
}

model Reservation {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @unique @db.Uuid
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productKeyId String     @unique @db.Uuid
  productKey   ProductKey @relation(fields: [productKeyId], references: [id], onDelete: Restrict)
  expiresAt    DateTime   @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("reservations")
}

model Delivery {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @unique @db.Uuid
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productKeyId String     @unique @db.Uuid
  productKey   ProductKey @relation(fields: [productKeyId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@map("deliveries")
}

model PaymentEvent {
  eventId          String        @id @db.VarChar(128)
  orderId          String        @db.Uuid
  status           PaymentStatus
  amount           Int
  currency         String        @db.VarChar(3)
  occurredAt       DateTime      @db.Timestamptz(3)
  receivedAt       DateTime      @default(now()) @db.Timestamptz(3)
  processedAt      DateTime?     @db.Timestamptz(3)
  processingResult String?

  @@index([orderId])
  @@index([processedAt, receivedAt])
  @@map("payment_events")
}
